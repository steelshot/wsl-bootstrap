#!/bin/bash
# Merges the RKE2 kubeconfig into the Windows kubeconfig under the {{ rke2_host_kubeconfig_name }} entry names and
# leaves every other cluster in that file alone. Prints "updated" when it wrote the file, and "unchanged" otherwise.
set -euo pipefail

source=/etc/rancher/rke2/rke2.yaml
target="{{ rke2_host_kubeconfig_path }}"
name="{{ rke2_host_kubeconfig_name }}"
kubectl=/var/lib/rancher/rke2/bin/kubectl

work=$(mktemp -d)
trap 'rm -rf -- "${work}"' EXIT

# RKE2 calls the cluster, user and context "default", which would clash with any other kubeconfig, so they are renamed.
{% if rke2_networking_mode in ['consomme', 'virtioproxy'] %}
# Consomme needs Windows localhost resolution rather than a literal 127.0.0.1.
{% endif %}
sed -E \
  -e "s/^( *(- )?name:) default$/\1 ${name}/" \
  -e "s/^( *(cluster|user):) default$/\1 ${name}/" \
  -e "s/^current-context: default$/current-context: ${name}/" \
{% if rke2_networking_mode in ['consomme', 'virtioproxy'] %}
  -e 's#^( *server:) https://127\.0\.0\.1:6443$#\1 https://localhost:6443#' \
{% endif %}
  "${source}" > "${work}/rke2.yaml"

# The first file wins when entries share a name, so the RKE2 entries replace the ones from an earlier build.
sources="${work}/rke2.yaml"
previous=""
if [ -f "${target}" ]; then
  sources="${sources}:${target}"
  previous=$(KUBECONFIG="${target}" "${kubectl}" config current-context 2>/dev/null || true)
fi

KUBECONFIG="${sources}" "${kubectl}" config view --flatten --raw > "${work}/merged.yaml"

# An existing current context is kept, so that merging does not switch clusters under the user.
if [ -n "${previous}" ] && [ "${previous}" != "${name}" ]; then
  KUBECONFIG="${work}/merged.yaml" "${kubectl}" config use-context "${previous}" > /dev/null
fi

if [ -f "${target}" ] && cmp -s "${work}/merged.yaml" "${target}"; then
  echo unchanged
  exit 0
fi

install -d -m 0700 "$(dirname -- "${target}")"
install -m 0600 "${work}/merged.yaml" "${target}"
echo updated
